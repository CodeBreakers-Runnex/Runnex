# Copie este arquivo para .env.local e preencha com os valores do seu
# projeto Firebase (Console do Firebase > Configuracoes do projeto > Seus apps).
# Nenhum destes valores e secreto: sao identificadores de cliente, protegidos
# pelas regras do Firestore/Storage e pelas restricoes de dominio/pacote do
# proprio Firebase — mas o arquivo .env.local continua fora do git mesmo assim.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend proprio, em migracao gradual saindo do Firestore (estado atual e
# granular, nao por dominio inteiro — ver "Backend e migracao" em
# docs/ARCHITECTURE.md em vez de confiar num resumo fixo aqui).
VITE_API_URL=http://localhost:8001

# Tiles do mapa (CARTO Dark Matter). Desde ago/2026 a CARTO exige chave: sem
# ela o mapa aparece com a marca d'agua "API KEY REQUIRED". Chave gratuita, sem
# conta, em https://carto.com/basemaps/apikey. Sem chave o app cai nos tiles da
# Esri (ok para dev, nao para producao).
VITE_CARTO_API_KEY=
